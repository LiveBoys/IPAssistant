<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="installerFileName" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="IPAssistantSetup-*.exe"
      company-name="Jiugang He"
      product-name="IP Assistant"
      product-version="${version}"
      file-version="${version}"
      original-filename="${installerFileName}">
      <authenticode-sign
        description="IP Assistant Installer"
        description-url="https://github.com/LiveBoys/IPAssistant" />
    </pe-file>
  </zip-file>
</artifact-configuration>
